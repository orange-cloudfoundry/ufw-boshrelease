#!/bin/bash
# Job control: invoked by monit (start/stop) and by the BOSH agent (drain).
set -e -o pipefail

export JOB_DIR=/var/vcap/jobs/ufw
export PATH=/var/vcap/packages/ufw/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/var/vcap/packages/ufw/lib

log_stream() {
  logger -tag ufw -p user."$1" 2>/dev/null || cat
}

case $1 in
  start)
    job_pidfile_path=/var/vcap/sys/run/ufw/ufw.pid
    job_run_path=/var/vcap/sys/run/ufw

    mkdir -p "$(dirname "$job_pidfile_path")" "$job_run_path"
    echo $$ > "${job_pidfile_path}"

    echo "job started at $(date)" | log_stream info
    "${JOB_DIR}/bin/start" >> /var/vcap/sys/log/ufw/start.log 2>&1
    echo "job finished (apply is a one-shot) at $(date)" | log_stream info

    # Start the sentinel daemon for monit (detach from current session with nohup+setsid)
    nohup setsid "${JOB_DIR}/bin/daemon" >/dev/null 2>&1 &
    echo $! > "${job_pidfile_path}"
    sleep 0.3
    # Verify it's alive
    if ! kill -0 "$(cat "${job_pidfile_path}")" 2>/dev/null; then
      echo "ERROR: daemon did not survive (check permissions or system limits)" | log_stream error
      exit 1
    fi
    ;;

  stop)
    job_pidfile_path=/var/vcap/sys/run/ufw/ufw.pid
    "${JOB_DIR}/bin/stop" >> /var/vcap/sys/log/ufw/stop.log 2>&1
    if [ -f "${job_pidfile_path}" ]; then
      kill "$(cat "${job_pidfile_path}")" 2>/dev/null || true
      rm -f "${job_pidfile_path}"
    fi
    ;;

  restart)
    $0 stop
    $0 start
    ;;

  drain)
    # No long-running process to drain. Keep filtering during a redeploy:
    # staying armed is the property ufw.stay_armed_on_stop governs at stop.
    echo "drain: nothing to wait for, exiting 0 at $(date)" >> /var/vcap/sys/log/ufw/drain.log 2>&1
    exit 0
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|drain}"
    exit 1
    ;;
esac
