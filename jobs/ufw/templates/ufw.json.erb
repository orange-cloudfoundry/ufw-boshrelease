<%
require 'json'

def ufw_valid_cidr?(cidr)
  return false unless cidr.is_a?(String)
  net, len = cidr.split('/', 2)
  return false if net.nil? || len.nil? || !len.match?(/\A[0-9]{1,3}\z/)
  if net.include?(':')
    return false unless len.to_i.between?(0, 128)
    return net.match?(/\A[0-9a-fA-F:]+\z/)
  end
  octets = net.split('.')
  return false unless octets.size == 4 && octets.all? { |o| o.match?(/\A[0-9]{1,3}\z/) && o.to_i <= 255 }
  len.to_i.between?(0, 32)
end

def ufw_valid_port?(port)
  case port
  when Integer
    port.between?(1, 65535)
  when String
    parts = port.split(':', 2)
    return false unless [1, 2].include?(parts.size)
    return false unless parts.all? { |p| p.match?(/\A[0-9]{1,5}\z/) && p.to_i.between?(1, 65535) }
    parts.size == 1 || parts[0].to_i <= parts[1].to_i
  else
    false
  end
end

def ufw_validate_rule!(rule, ctx)
  raise "#{ctx}: rule must be a mapping, got #{rule.class}" unless rule.is_a?(Hash)
  desc = rule['description']
  raise "#{ctx}: rule needs a non-empty description (rendered as the ufw comment tag)" unless desc.is_a?(String) && !desc.strip.empty?
  raise "#{ctx}: description must not contain single quotes: #{desc}" if desc.include?("'")
  froms = rule['from']
  froms = [froms] if froms.is_a?(String)
  raise "#{ctx} '#{desc}': from must be a non-empty list of CIDRs" unless froms.is_a?(Array) && !froms.empty?
  froms.each { |c| raise "#{ctx} '#{desc}': invalid source CIDR '#{c}'" unless ufw_valid_cidr?(c) }
  ports = rule['to_ports']
  ports = [ports] if ports.is_a?(Numeric) || ports.is_a?(String)
  raise "#{ctx} '#{desc}': to_ports must be a non-empty list of ports/port-ranges" unless ports.is_a?(Array) && !ports.empty?
  ports.each { |p| raise "#{ctx} '#{desc}': invalid port '#{p}'" unless ufw_valid_port?(p) }
  proto = rule['protocol']
  raise "#{ctx} '#{desc}': protocol must be one of tcp, udp, tcp/udp (got '#{proto}')" unless ['tcp', 'udp', 'tcp/udp'].include?(proto)
end

def ufw_commands(rule, tag)
  cmds = []
  Array(rule['from']).each do |cidr|
    Array(rule['to_ports']).each do |port|
      cmds << "allow from #{cidr} to any port #{port} proto #{rule['protocol']} comment '#{tag} #{rule['description']}'"
    end
  end
  cmds
end

logging = p('ufw.logging')
raise "ufw.logging must be one of low|medium|high|full|off (got '#{logging}')" unless ['low', 'medium', 'high', 'full', 'off'].include?(logging)

baseline = p('ufw.allow_bosh')
if baseline.nil? || baseline.empty?
  raise "ufw.allow_bosh is required: refusing to render a firewall without the inbound operational allow baseline (SSH/monitoring sources; operator lockout risk). BOSH control plane (NATS agent, HM, blobstore) is agent-initiated egress and needs no inbound allow."
end

tag = "paas-ufw/#{spec.name}"
commands = []
all_rules = baseline + Array(p('ufw.rules'))
all_rules.each_with_index do |rule, i|
  ctx = i < Array(baseline).size ? "ufw.allow_bosh[#{i}]" : "ufw.rules[#{i - Array(baseline).size}]"
  ufw_validate_rule!(rule, ctx)
  commands.concat(ufw_commands(rule, tag))
end
commands.uniq!

desired = {
  'tag' => tag,
  'enforce' => p('ufw.enforce'),
  'logging' => logging,
  'ipv6' => p('ufw.ipv6'),
  'stay_armed_on_stop' => p('ufw.stay_armed_on_stop'),
  'commands' => commands,
}
-%>
<%= JSON.pretty_generate(desired) %>
