set -e # exit immediately if a simple command exits with a non-zero status
set -u # report the usage of uninitialized variables

# Available variables
# $BOSH_COMPILE_TARGET - where this package & spec'd source files are available
# $BOSH_INSTALL_TARGET - where you copy/install files to be included on the VM
export HOME=/var/vcap

# ufw's setup.py imports distutils directly, but stemcell Python installs may
# omit distutils' commands and/or setuptools. Vendor a compatible setuptools
# wheel and build an isolated compile environment: this keeps package
# compilation hermetic and independent of the stemcell OS Python modules.
SETUPTOOLS_WHEEL="${BOSH_COMPILE_TARGET}/setuptools/wheel/setuptools-79.0.1-py3-none-any.whl"
test -f "${SETUPTOOLS_WHEEL}"
BUILD_ENV="${BOSH_COMPILE_TARGET}/build-env"
BUILD_PYTHON="${BUILD_ENV}/bin/python"
SITE_PACKAGES=$(python3 - "${BUILD_ENV}" "${SETUPTOOLS_WHEEL}" <<'PY'
import os
import subprocess
import sys
import venv
import zipfile

build_env, wheel = sys.argv[1:3]
python = os.path.join(build_env, 'bin', 'python')
if not os.path.isdir(build_env):
    venv.create(build_env, with_pip=False)
site_packages = subprocess.run(
    [python, '-c', 'import sysconfig; print(sysconfig.get_paths()["purelib"])'],
    check=True, text=True, stdout=subprocess.PIPE,
).stdout.strip()
os.makedirs(site_packages, exist_ok=True)
with zipfile.ZipFile(wheel) as archive:
    archive.extractall(site_packages)
print(site_packages)
PY
)

# Expose setuptools' bundled distutils as the standard `distutils` namespace.
# The isolated env interpreter imports site (hence sitecustomize) before
# running setup.py, which imports distutils directly at module level.
cat > "${SITE_PACKAGES}/sitecustomize.py" <<'PY'
import sys

try:
    import distutils.command.install  # noqa: F401
except Exception:
    import setuptools._distutils as _distutils
    import setuptools._distutils.command as _distutils_command

    for name in tuple(sys.modules):
        if name == 'distutils' or name.startswith('distutils.'):
            del sys.modules[name]
    _distutils.__name__ = 'distutils'
    _distutils.command = _distutils_command
    sys.modules['distutils'] = _distutils
    sys.modules['distutils.command'] = _distutils_command
PY

tar xzf "${BOSH_COMPILE_TARGET}/ufw/ufw.orig.tar.gz"
cd ufw-*/

# setup.py runs 'make mo' (needs gettext/msgfmt) only when locales/mo is empty.
# Translations are useless for a headless frontend: keep the dir non-empty to skip.
mkdir -p locales/mo
touch locales/mo/.keep

# Install with canonical baked-in paths: ufw's setup.py stamps #PREFIX#->/usr,
# #CONFIG_PREFIX#->/etc, #STATE_PREFIX#->/lib/ufw, #SHARE_DIR#->/usr/share/ufw
# and --root only relocates the files on disk (same trick Debian builds with).
# The job's pre-start seeds /etc/ufw, /etc/default/ufw, /lib/ufw and
# /usr/share/ufw/iptables from this package; the job calls the CLI through
# bin/ufw with PYTHONPATH pointed at the packaged python modules.
#
# Notes:
# - setup.py hard-fails unless iptables{,6,-restore} exist on the compile VM:
#   always true on BOSH stemcells (/usr/sbin).
# - UFW_SKIP_CHECKS=1 skips runtime firewall checks at build time
#   (same as upstream's own Makefile build target).
# - run under the isolated env interpreter: it carries setuptools and resolves
#   python module install dirs consistently (modules land in
#   usr/lib/python3.X/site-packages under the --root, found by the job's
#   PYTHONPATH fallback).
UFW_SKIP_CHECKS=1 "${BUILD_PYTHON}" ./setup.py install --root="${BOSH_INSTALL_TARGET}" --prefix=/usr

# setup.py stamps its own interpreter (the isolated build env) into the ufw
# shebang; rewrite it to the stemcell's system python3. The job's bin/ufw
# wrapper points PYTHONPATH at the packaged modules, so the ufw CLI runs with
# system python3 + packaged ufw modules.
sed -i '1s|^#!.*python.*|#! /usr/bin/env python3|' "${BOSH_INSTALL_TARGET}/usr/sbin/ufw"

# record provenance for ops (ufw --version only shows the frontend version)
grep -oP "^ufw_version = '\K[^']+" setup.py > "${BOSH_INSTALL_TARGET}/UPSTREAM-VERSION"

test -x "${BOSH_INSTALL_TARGET}/usr/sbin/ufw"
test -d "${BOSH_INSTALL_TARGET}/usr/share/ufw/iptables"
test -d "${BOSH_INSTALL_TARGET}/etc/ufw"
test -f "${BOSH_INSTALL_TARGET}/lib/ufw/ufw-init"
# python modules must land in a python3 (dist|site)-packages dir (versioned
# or unversioned depends on the install environment)
find "${BOSH_INSTALL_TARGET}/usr/lib" \( -path '*/dist-packages/ufw/common.py' -o -path '*/site-packages/ufw/common.py' \) | grep -q .

# the compile env is build-time only: never ship it inside the package
rm -rf "${BUILD_ENV}"
